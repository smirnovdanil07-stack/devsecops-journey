# Берем базовые образ Python (легкую версию) 
FROM python:3.11-slim

# Создаем рабочую директорию внутри контейнера 
WORKDIR /app

# Копируем наш скрипт и тестовый лок в котнейнер 
COPY check_logs.py .
COPY test.log .

# Указываем команду которая выполниться при запуске контейнера 
CMD ["python3", "check_logs.py", "test.log"]
